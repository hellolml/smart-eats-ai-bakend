# APP_NAME
# 说明：应用名称，用于日志与元信息展示
# 推荐值：smart-eats
# 本地示例：smart-eats
APP_NAME=smart-eats

# ENV
# 说明：运行环境（影响日志/错误输出）
# 推荐值：development
# 本地示例：development
ENV=development

# DEBUG
# 说明：是否开启调试日志（LLM 原始输出等）
# 推荐值：false
# 本地示例：false
DEBUG=false

# DEFAULT_LANGUAGE
# 说明：默认语言（影响提示词与前端默认展示）
# 推荐值：zh
# 本地示例：zh
DEFAULT_LANGUAGE=zh

# LANGGRAPH_CHECKPOINT_DB
# 说明：LangGraph 检查点 SQLite 文件路径
# 推荐值：.langgraph_checkpoints.sqlite
# 本地示例：.langgraph_checkpoints.sqlite
LANGGRAPH_CHECKPOINT_DB=.langgraph_checkpoints.sqlite

# LANGGRAPH_CHECKPOINT_BACKEND
# 说明：检查点存储后端（memory/sqlite/none），memory 仅本次工作流有效
# 推荐值：sqlite
# 本地示例：sqlite
LANGGRAPH_CHECKPOINT_BACKEND=sqlite

# LANGGRAPH_DURABILITY
# 说明：持久化模式（exit/async/sync），不支持则自动忽略
# 推荐值：async
# 本地示例：async
LANGGRAPH_DURABILITY=async

# DATABASE_URL
# 说明：异步数据库连接串（本地建议 SQLite）
# 推荐值：sqlite+aiosqlite:///./local.db
# 本地示例：sqlite+aiosqlite:///./local.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/smart_eats

# REDIS_URL
# 说明：Redis 连接串（缓存/限流/SSE/摘要队列）
# 推荐值：redis://127.0.0.1:6379/0
# 本地示例：redis://127.0.0.1:6379/0
REDIS_URL=redis://localhost:6379/0

# JWT_SECRET
# 说明：JWT 签名密钥
# 推荐值：change-me（生产需替换）
# 本地示例：change-me
JWT_SECRET=change-me

# JWT_ISSUER
# 说明：JWT issuer
# 推荐值：smart-eats
# 本地示例：smart-eats
JWT_ISSUER=smart-eats

# JWT_AUDIENCE
# 说明：JWT audience
# 推荐值：smart-eats-clients
# 本地示例：smart-eats-clients
JWT_AUDIENCE=smart-eats-clients

# JWT_ALG
# 说明：JWT 算法
# 推荐值：HS256
# 本地示例：HS256
JWT_ALG=HS256

# ACCESS_TOKEN_TTL_SECONDS
# 说明：Access Token 有效期（秒）
# 推荐值：900
# 本地示例：900
ACCESS_TOKEN_TTL_SECONDS=900

# REFRESH_TOKEN_TTL_SECONDS
# 说明：Refresh Token 有效期（秒）
# 推荐值：604800
# 本地示例：604800
REFRESH_TOKEN_TTL_SECONDS=604800

# CHAT_CANCEL_TTL
# 说明：SSE Stop 标记 TTL（秒）
# 推荐值：600
# 本地示例：600
CHAT_CANCEL_TTL=600

# CHAT_HISTORY_LIMIT
# 说明：喂给模型的最大历史条数
# 推荐值：30
# 本地示例：30
CHAT_HISTORY_LIMIT=30

# CHAT_HISTORY_CACHE_LIMIT
# 说明：Redis 历史缓存最多保留条数
# 推荐值：120
# 本地示例：120
CHAT_HISTORY_CACHE_LIMIT=120

# CHAT_HISTORY_CACHE_TTL_SECONDS
# 说明：Redis 历史缓存 TTL（秒）
# 推荐值：300
# 本地示例：300
CHAT_HISTORY_CACHE_TTL_SECONDS=300

# CHAT_HISTORY_LOCAL_CACHE_SIZE
# 说明：进程内 LRU 最多缓存会话数
# 推荐值：256
# 本地示例：256
CHAT_HISTORY_LOCAL_CACHE_SIZE=256

# CHAT_HISTORY_LOCAL_CACHE_TTL_SECONDS
# 说明：进程内 LRU 缓存 TTL（秒）
# 推荐值：30
# 本地示例：30
CHAT_HISTORY_LOCAL_CACHE_TTL_SECONDS=30

# CHAT_HISTORY_CACHE_MODE
# 说明：缓存策略（local_first/local_validate/redis_only）
# 推荐值：local_validate
# 本地示例：local_validate
CHAT_HISTORY_CACHE_MODE=local_validate

# CHAT_SUMMARY_TRIGGER
# 说明：历史条数达到阈值触发摘要任务
# 推荐值：24
# 本地示例：24
CHAT_SUMMARY_TRIGGER=24

# CHAT_SUMMARY_TAIL
# 说明：摘要后保留最近消息条数
# 推荐值：8
# 本地示例：8
CHAT_SUMMARY_TAIL=8

# CHAT_SUMMARY_TTL_SECONDS
# 说明：摘要缓存 TTL（秒）
# 推荐值：3600
# 本地示例：3600
CHAT_SUMMARY_TTL_SECONDS=3600

# CHAT_SUMMARY_QUEUE
# 说明：摘要任务队列名（Redis list）
# 推荐值：queue:chat_summary
# 本地示例：queue:chat_summary
CHAT_SUMMARY_QUEUE=queue:chat_summary

# CHAT_PAUSE_TTL
# 说明：暂停/恢复标记 TTL（秒）
# 推荐值：600
# 本地示例：600
CHAT_PAUSE_TTL=600

# SEED_DEMO_USER_ID
# 说明：种子演示用户 ID（用于开发模式）
# 推荐值：802d5cb9-5bc9-4959-ab91-0ddd51ce106e
# 本地示例：802d5cb9-5bc9-4959-ab91-0ddd51ce106e
SEED_DEMO_USER_ID=802d5cb9-5bc9-4959-ab91-0ddd51ce106e

# AMAP_SEARCH_CACHE_TTL_SECONDS
# 说明：高德附近餐厅搜索缓存 TTL（秒）
# 推荐值：180
# 本地示例：180
AMAP_SEARCH_CACHE_TTL_SECONDS=180

# RESTAURANT_DETAIL_CACHE_TTL_SECONDS
# 说明：餐厅详情缓存 TTL（秒）
# 推荐值：300
# 本地示例：300
RESTAURANT_DETAIL_CACHE_TTL_SECONDS=300

# MCP_SERVERS_CONFIG_PATH
# 说明：MCP 多服务器配置文件路径（JSON）
# 推荐值：./mcp_servers.json
# 本地示例：./mcp_servers.json
MCP_SERVERS_CONFIG_PATH=./mcp_servers.json

# CONTEXT_SNAPSHOT_TTL_SECONDS
# 说明：Context 快照缓存 TTL（秒）
# 推荐值：600
# 本地示例：600
CONTEXT_SNAPSHOT_TTL_SECONDS=600

# MINIO_BUCKET
# 说明：MinIO bucket 名称
# 推荐值：smart-eats
# 本地示例：smart-eats
MINIO_BUCKET=smart-eats

# MINIO_BASE_PATH
# 说明：MinIO 本地 stub 目录
# 推荐值：.minio_stub
# 本地示例：.minio_stub
MINIO_BASE_PATH=.minio_stub

# RECOGNITION_EVENT_TTL_SECONDS
# 说明：冰箱识别 SSE 事件 TTL（秒）
# 推荐值：600
# 本地示例：600
RECOGNITION_EVENT_TTL_SECONDS=600

# OPENAI_API_KEY
# 说明：OpenAI Key（留空则禁用该 provider）
# 推荐值：本地填写
# 本地示例：sk-...
OPENAI_API_KEY=

# OPENAI_BASE_URL
# 说明：OpenAI Base URL
# 推荐值：https://api.openai.com/v1
# 本地示例：https://api.openai.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# OPENAI_MODEL_PLANNER
# 说明：Planner 使用的 OpenAI 模型
# 推荐值：gpt-4o-mini
# 本地示例：gpt-4o-mini
OPENAI_MODEL_PLANNER=gpt-4o-mini

# OPENAI_MODEL_WRITER
# 说明：Writer 使用的 OpenAI 模型
# 推荐值：gpt-4o-mini
# 本地示例：gpt-4o-mini
OPENAI_MODEL_WRITER=gpt-4o-mini

# LLM_PROVIDER
# 说明：默认大模型提供方（openai/deepseek/qwen）
# 推荐值：qwen
# 本地示例：qwen
LLM_PROVIDER=qwen

# LLM_PROVIDERS
# 说明：前端可选 provider 列表
# 推荐值：openai,deepseek,qwen
# 本地示例：openai,deepseek,qwen
LLM_PROVIDERS=openai,deepseek,qwen

# DEEPSEEK_API_KEY
# 说明：DeepSeek API Key
# 推荐值：本地填写
# 本地示例：ds-...
DEEPSEEK_API_KEY=

# DEEPSEEK_BASE_URL
# 说明：DeepSeek Base URL
# 推荐值：https://api.deepseek.com
# 本地示例：https://api.deepseek.com
DEEPSEEK_BASE_URL=https://api.deepseek.com

# DEEPSEEK_MODEL_PLANNER
# 说明：Planner 使用的 DeepSeek 模型
# 推荐值：deepseek-chat
# 本地示例：deepseek-chat
DEEPSEEK_MODEL_PLANNER=deepseek-chat

# DEEPSEEK_MODEL_WRITER
# 说明：Writer 使用的 DeepSeek 模型
# 推荐值：deepseek-chat
# 本地示例：deepseek-chat
DEEPSEEK_MODEL_WRITER=deepseek-chat

# DASHSCOPE_API_KEY
# 说明：DashScope API Key（Qwen）
# 推荐值：本地填写
# 本地示例：sk-...
DASHSCOPE_API_KEY=

# QWEN_BASE_URL
# 说明：Qwen 兼容模式 Base URL
# 推荐值：https://dashscope.aliyuncs.com/compatible-mode/v1
# 本地示例：https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# QWEN_MODEL_PLANNER
# 说明：Planner 使用的 Qwen 模型
# 推荐值：qwen-plus
# 本地示例：qwen-plus
QWEN_MODEL_PLANNER=qwen-plus

# QWEN_MODEL_WRITER
# 说明：Writer 使用的 Qwen 模型
# 推荐值：qwen-plus
# 本地示例：qwen-plus
QWEN_MODEL_WRITER=qwen-plus

# LLM_REQUEST_LOG
# 说明：是否输出 LLM 请求日志（system/user/both/none）
# 推荐值：none
# 本地示例：none
LLM_REQUEST_LOG=none

# AGENT_MAX_STEPS
# 说明：工具循环最大次数（防止死循环）
# 推荐值：4
# 本地示例：4
AGENT_MAX_STEPS=4
