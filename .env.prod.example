# ===== Runtime =====
APP_NAME=smart-eats
ENV=production
DEBUG=false
DEFAULT_LANGUAGE=zh

# ===== Database / Redis (inside docker network) =====
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-strong-password
POSTGRES_DB=smart_eats
DATABASE_URL=postgresql+asyncpg://postgres:change-this-strong-password@postgres:5432/smart_eats
REDIS_URL=redis://redis:6379/0

# ===== Auth =====
JWT_SECRET=replace-with-long-random-secret
JWT_ISSUER=smart-eats
JWT_AUDIENCE=smart-eats-clients
JWT_ALG=HS256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# ===== App behavior =====
APP_FALLBACK_ENABLED=false
CHAT_CANCEL_TTL=600
CHAT_HISTORY_LIMIT=30
CHAT_HISTORY_CACHE_LIMIT=120
CHAT_HISTORY_CACHE_TTL_SECONDS=300
CHAT_HISTORY_LOCAL_CACHE_SIZE=256
CHAT_HISTORY_LOCAL_CACHE_TTL_SECONDS=30
CHAT_HISTORY_CACHE_MODE=local_validate
TOOL_HISTORY_KEEP=3
TOOL_HISTORY_ALLOW=get_ip_location,geocode_location,search_restaurants,plan_route,get_weather,rag_search_recipes,search_recipes
CHAT_COMPACT_MIN_MESSAGES=3
CHAT_COMPACT_TRIGGER_RATIO=0.9
CHAT_COMPACT_TAIL_RATIO=0.2
LLM_MODEL_CONTEXT_SIZE=8192
CONTEXT_SNAPSHOT_TTL_SECONDS=600
MINIO_BUCKET=smart-eats
MINIO_BASE_PATH=.minio_stub
RECOGNITION_EVENT_TTL_SECONDS=600
AGENT_MAX_STEPS=6
LANGGRAPH_CHECKPOINT_DB=.langgraph_checkpoints.sqlite
LANGGRAPH_DURABILITY=async
LANGGRAPH_CHECKPOINT_BACKEND=sqlite
SEED_DEMO_USER_ID=
AMAP_SEARCH_CACHE_TTL_SECONDS=180
RESTAURANT_DETAIL_CACHE_TTL_SECONDS=300
MCP_SERVERS_CONFIG_PATH=/app/mcp_servers.json
APP_RECIPE_GEN_TIMEOUT_SECONDS=12

# ===== LLM provider =====
LLM_PROVIDER=qwen
LLM_PROVIDERS=openai,deepseek,qwen

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_PLANNER=gpt-4o-mini
OPENAI_MODEL_WRITER=gpt-4o-mini

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_PLANNER=deepseek-chat
DEEPSEEK_MODEL_WRITER=deepseek-chat

DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL_PLANNER=qwen-plus
QWEN_MODEL_WRITER=qwen-plus

LLM_REQUEST_LOG=none

# ===== Frontend build/runtime =====
# IMPORTANT:
# - If you enable HTTPS on a single domain (recommended), set APP_API_BASE_URL=https://$DOMAIN
#   Otherwise browsers will block calls from https://<DOMAIN> -> http://localhost:8000
APP_API_BASE_URL=
# When NOT using gateway, frontend can be exposed on this port (e.g. 8080).
# When using gateway (HTTPS_ENABLED=true), frontend ports are disabled by docker-compose.https.yml.
FRONTEND_HOST_PORT=8080

# ===== HTTPS gateway (default: single-domain) =====
# Set to true to enable gateway (80/443) and certbot.
HTTPS_ENABLED=false

# Single domain used for both frontend + API path proxy
DOMAIN=eatwhat.cloud

# Optional: email for Let's Encrypt. If empty, certbot will register without email.
LETSENCRYPT_EMAIL=

# Advanced (two-domain mode, optional)
# If your DNS supports subdomains, you can use a dedicated API domain.
# HTTPS_MODE=dual
# APP_DOMAIN=app.yourdomain.com
# API_DOMAIN=api.yourdomain.com
HTTPS_MODE=single

# Image tag for compose (optional)
IMAGE_TAG=latest
