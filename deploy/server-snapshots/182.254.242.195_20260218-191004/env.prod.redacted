# Redacted snapshot of server .env.prod (secrets removed)
# server: 182.254.242.195

APP_NAME=smart-eats
ENV=production
DEBUG=false
DEFAULT_LANGUAGE=zh

POSTGRES_USER=postgres
POSTGRES_PASSWORD=***
POSTGRES_DB=smart_eats
DATABASE_URL=postgresql+asyncpg://postgres:***@postgres:5432/smart_eats
REDIS_URL=redis://redis:6379/0

JWT_SECRET=***
JWT_ISSUER=smart-eats
JWT_AUDIENCE=smart-eats-clients
JWT_ALG=HS256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# ... (unchanged app behavior settings omitted for brevity)

LLM_PROVIDER=qwen
OPENAI_API_KEY=***
DEEPSEEK_API_KEY=***
DASHSCOPE_API_KEY=***

# Critical for single-domain HTTPS deployments:
APP_API_BASE_URL=https://eatwhat.cloud
FRONTEND_HOST_PORT=8080

HTTPS_ENABLED=true
# server had placeholder dual-domain vars present; single-domain gateway.conf is used instead
HTTPS_MODE=single
DOMAIN=eatwhat.cloud
LETSENCRYPT_EMAIL=***
